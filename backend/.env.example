# Copy to .env and fill in. Never commit the real .env — it's gitignored.

# Port to listen on. Hosts like Render inject this automatically;
# only set it locally.
PORT=3000

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key from Supabase > Settings > API.
#
# Use the LEGACY JWT-format key (starts with "eyJ"), found under the
# "Legacy anon, service_role API keys" tab — not the newer sb_secret_...
# key, which the Auth server rejects when verifying user sessions.
#
# This key bypasses Row Level Security. Server-side only, never ship it
# to the extension.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio API key used for all Gemini calls.
GEMINI_API_KEY=

# Optional. Comma-separated origins allowed to make browser requests.
# Leave unset for local dev (permissive). In production set it to your
# extension's origin, e.g. chrome-extension://<extension-id>
ALLOWED_ORIGINS=
